
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  SHORT
  HERO
  SMALL
  LIST
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String   @unique
  password        String
  sources         String[]
  profileImageUrl String?
  bio             String?
  bannerUrl       String?
  createdAt       DateTime @default(now())
}

model Article {
  id          String      @id @default(cuid())
  categoryId  String?
  title       String
  description String
  summary     String
  biasLevel   Float
  imageUrl    String?
  sources     Json
  type        ArticleType
  createdAt   DateTime @default(now())

  category    Category? @relation(fields: [categoryId], references: [id])
}

model Perspective {
  id          String   @id @default(cuid())
  title       String
  neutral     Json
  extreme     Json
  createdAt   DateTime @default(now())
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  averageBias   Float
  createdAt     DateTime @default(now())

  articles      Article[]
}

model Archived {
  id          String   @id @default(cuid())
  articles    Json
  createdAt   DateTime @default(now())
}
